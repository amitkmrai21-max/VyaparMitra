GROQ_API_KEY=put_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Comma-separated list of origins allowed to call this API.
# Defaults to the GitHub Pages site plus common local dev ports if unset.
ALLOWED_ORIGINS=https://amitkmrai21-max.github.io,http://localhost:3000,http://127.0.0.1:5500

# Per-IP rate limit on /api/generate-campaign (each call costs Groq quota).
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Razorpay (subscriptions). Get these from the Razorpay dashboard after
# signing up at razorpay.com and completing KYC — Settings > API Keys.
# RAZORPAY_KEY_ID is also embedded in the frontend checkout, so it's fine to
# be public; RAZORPAY_KEY_SECRET must never be shared or committed anywhere.
RAZORPAY_KEY_ID=put_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=put_your_razorpay_key_secret_here
SUBSCRIPTION_AMOUNT_PAISE=19900
SUBSCRIPTION_PERIOD_DAYS=30

# Same Supabase project the frontend uses (Settings > API in Supabase).
# SUPABASE_ANON_KEY is the same public/publishable key already in
# docs/app.js — never put a service-role key here.
SUPABASE_URL=https://chpflrrfplyhfpmxiusm.supabase.co
SUPABASE_ANON_KEY=put_your_supabase_anon_key_here
