GROQ_API_KEY=put_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Comma-separated list of origins allowed to call this API.
# Defaults to the GitHub Pages site plus common local dev ports if unset.
ALLOWED_ORIGINS=https://amitkmrai21-max.github.io,http://localhost:3000,http://127.0.0.1:5500

# Per-IP rate limit on /api/generate-campaign (each call costs Groq quota).
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
